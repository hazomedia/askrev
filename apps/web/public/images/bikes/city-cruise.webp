<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" width="100%" height="100%">
  <defs>
    <linearGradient id="studioBg2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F1F5F9" />
    </linearGradient>
    <linearGradient id="bodyGreen" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#166534" />
      <stop offset="50%" stop-color="#15803D" />
      <stop offset="100%" stop-color="#14532D" />
    </linearGradient>
    <filter id="softShadow2" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0F172A" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Clean Studio Background -->
  <rect width="800" height="480" fill="url(#studioBg2)" rx="12" />

  <!-- Ground Soft Shadow -->
  <ellipse cx="400" cy="395" rx="300" ry="18" fill="#64748B" opacity="0.16" />

  <!-- Rear Wheel -->
  <g id="rearWheel">
    <circle cx="230" cy="335" r="70" fill="#1E293B" stroke="#0F172A" stroke-width="12" />
    <circle cx="230" cy="335" r="56" fill="#334155" stroke="#94A3B8" stroke-width="2" />
    <circle cx="230" cy="335" r="28" fill="#E2E8F0" stroke="#64748B" stroke-width="2" />
    <circle cx="230" cy="335" r="12" fill="#15803D" />
    <line x1="230" y1="279" x2="230" y2="391" stroke="#94A3B8" stroke-width="2" />
    <line x1="174" y1="335" x2="286" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="230" cy="335" r="40" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="3,3" />
    <rect x="204" y="322" width="16" height="26" rx="3" fill="#165DAD" />
  </g>

  <!-- Front Wheel -->
  <g id="frontWheel">
    <circle cx="590" cy="335" r="70" fill="#1E293B" stroke="#0F172A" stroke-width="12" />
    <circle cx="590" cy="335" r="56" fill="#334155" stroke="#94A3B8" stroke-width="2" />
    <circle cx="590" cy="335" r="28" fill="#E2E8F0" stroke="#64748B" stroke-width="2" />
    <circle cx="590" cy="335" r="12" fill="#15803D" />
    <line x1="590" y1="279" x2="590" y2="391" stroke="#94A3B8" stroke-width="2" />
    <line x1="534" y1="335" x2="646" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="590" cy="335" r="40" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="3,3" />
    <rect x="598" y="322" width="16" height="26" rx="3" fill="#165DAD" />
  </g>

  <!-- Step-Through Chassis Body in Forest Green -->
  <path d="M 230 335 L 370 330 L 430 315 L 480 235 L 530 175 L 490 175 L 390 275 L 290 275 Z" fill="url(#bodyGreen)" filter="url(#softShadow2)" />
  <rect x="330" y="275" width="120" height="40" rx="6" fill="#1E293B" />
  <text x="390" y="300" fill="#E2E8F0" font-size="10" font-weight="700" text-anchor="middle" font-family="Inter, sans-serif">2.5 kWh LFP PACK</text>

  <!-- Comfort Saddle -->
  <path d="M 270 255 Q 320 245 370 260 L 360 275 L 280 275 Z" fill="#0F172A" />

  <!-- Upright Handlebars -->
  <line x1="590" y1="335" x2="520" y2="145" stroke="#64748B" stroke-width="8" stroke-linecap="round" />
  <path d="M 520 145 L 490 115 L 530 110" fill="none" stroke="#334155" stroke-width="6" stroke-linecap="round" />

  <!-- Headlight -->
  <circle cx="535" cy="175" r="10" fill="#E2E8F0" />
  <circle cx="535" cy="175" r="5" fill="#15803D" />

  <!-- Model Branding -->
  <text x="420" y="215" fill="#253247" font-size="18" font-weight="800" font-family="Inter, sans-serif">CITY <tspan fill="#15803D">CRUISE</tspan></text>
  <text x="420" y="230" fill="#64748B" font-size="10" font-weight="500" font-family="Inter, sans-serif">DAILY URBAN EFFICIENCY</text>

  <!-- Clean Specs Pills in White Corporate Style -->
  <g transform="translate(60, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">RANGE</text>
    <text x="12" y="29" fill="#15803D" font-size="13" font-weight="800" font-family="Inter, sans-serif">90 km</text>
  </g>
  <g transform="translate(195, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">TOP SPEED</text>
    <text x="12" y="29" fill="#165DAD" font-size="13" font-weight="800" font-family="Inter, sans-serif">70 km/h</text>
  </g>
</svg>
