<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0B132B" />
      <stop offset="100%" stop-color="#060B18" />
    </linearGradient>
    <linearGradient id="frameGrad" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#00B4D8" />
      <stop offset="50%" stop-color="#0077B6" />
      <stop offset="100%" stop-color="#03045E" />
    </linearGradient>
    <linearGradient id="neonGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00B4D8" />
      <stop offset="100%" stop-color="#10B981" />
    </linearGradient>
    <linearGradient id="rimGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1C2541" />
      <stop offset="100%" stop-color="#0B132B" />
    </linearGradient>
    <filter id="glowFilter" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Base -->
  <rect width="800" height="480" fill="url(#bgGrad)" rx="16" />
  
  <!-- Subtle Grid Lines -->
  <g opacity="0.08" stroke="#00B4D8" stroke-width="1">
    <line x1="0" y1="120" x2="800" y2="120" />
    <line x1="0" y1="240" x2="800" y2="240" />
    <line x1="0" y1="360" x2="800" y2="360" />
    <line x1="200" y1="0" x2="200" y2="480" />
    <line x1="400" y1="0" x2="400" y2="480" />
    <line x1="600" y1="0" x2="600" y2="480" />
  </g>

  <!-- Ground Plane & Shadow -->
  <ellipse cx="400" cy="400" rx="320" ry="24" fill="#000000" opacity="0.6" filter="url(#glowFilter)" />
  <line x1="80" y1="400" x2="720" y2="400" stroke="#00B4D8" stroke-width="2" opacity="0.3" />

  <!-- Rear Wheel Assembly -->
  <g id="rearWheel">
    <circle cx="210" cy="340" r="76" fill="#111827" stroke="#1F2937" stroke-width="14" />
    <circle cx="210" cy="340" r="62" fill="url(#rimGrad)" stroke="#00B4D8" stroke-width="3" opacity="0.8" />
    <circle cx="210" cy="340" r="32" fill="#0B132B" stroke="#3A506B" stroke-width="2" />
    <circle cx="210" cy="340" r="14" fill="#00B4D8" />
    <!-- Spokes -->
    <line x1="210" y1="278" x2="210" y2="402" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="148" y1="340" x2="272" y2="340" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="166" y1="296" x2="254" y2="384" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="166" y1="384" x2="254" y2="296" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <!-- Disc Brake & Caliper -->
    <circle cx="210" cy="340" r="42" fill="none" stroke="#64748B" stroke-width="3" stroke-dasharray="4,4" />
    <rect x="180" y="325" width="20" height="30" rx="4" fill="#10B981" />
  </g>

  <!-- Front Wheel Assembly -->
  <g id="frontWheel">
    <circle cx="610" cy="340" r="76" fill="#111827" stroke="#1F2937" stroke-width="14" />
    <circle cx="610" cy="340" r="62" fill="url(#rimGrad)" stroke="#00B4D8" stroke-width="3" opacity="0.8" />
    <circle cx="610" cy="340" r="32" fill="#0B132B" stroke="#3A506B" stroke-width="2" />
    <circle cx="610" cy="340" r="14" fill="#00B4D8" />
    <!-- Spokes -->
    <line x1="610" y1="278" x2="610" y2="402" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="548" y1="340" x2="672" y2="340" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="566" y1="296" x2="654" y2="384" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <line x1="566" y1="384" x2="654" y2="296" stroke="#00B4D8" stroke-width="2" opacity="0.5" />
    <!-- Disc Brake & Caliper -->
    <circle cx="610" cy="340" r="42" fill="none" stroke="#64748B" stroke-width="3" stroke-dasharray="4,4" />
    <rect x="620" y="325" width="20" height="30" rx="4" fill="#10B981" />
  </g>

  <!-- Swingarm & Chain Drive -->
  <path d="M 210 340 L 380 320 L 370 345 Z" fill="#1E293B" stroke="#334155" stroke-width="2" />

  <!-- Monoshock Suspension -->
  <line x1="330" y1="310" x2="360" y2="250" stroke="#EF4444" stroke-width="8" stroke-linecap="round" />
  <line x1="330" y1="310" x2="360" y2="250" stroke="#F87171" stroke-width="4" stroke-dasharray="4,4" stroke-linecap="round" />

  <!-- Battery Pack Enclosure (Underbody) -->
  <polygon points="290,340 470,340 490,260 320,260" fill="#0F172A" stroke="#00B4D8" stroke-width="2" />
  <!-- Cooling Vents & Battery Indicator -->
  <g stroke="#00B4D8" stroke-width="2" opacity="0.7">
    <line x1="340" y1="280" x2="450" y2="280" />
    <line x1="330" y1="300" x2="460" y2="300" />
    <line x1="320" y1="320" x2="460" y2="320" />
  </g>
  <rect x="360" y="270" width="70" height="12" rx="4" fill="#00B4D8" opacity="0.9" filter="url(#glowFilter)" />
  <text x="395" y="279" fill="#060B18" font-size="8" font-weight="900" text-anchor="middle" font-family="sans-serif">3.8 kWh PMSM</text>

  <!-- Main Chassis Frame & Tank Cover -->
  <path d="M 240 250 L 360 250 L 460 170 L 530 180 L 570 230 L 480 310 L 330 310 Z" fill="url(#frameGrad)" stroke="#38BDF8" stroke-width="2" />

  <!-- Ergonomic Saddle / Seat -->
  <path d="M 230 240 Q 300 235 370 248 L 380 230 Q 300 215 240 225 Z" fill="#020617" stroke="#334155" stroke-width="2" />

  <!-- Front Inverted Fork Suspension -->
  <line x1="610" y1="340" x2="540" y2="160" stroke="#94A3B8" stroke-width="10" stroke-linecap="round" />
  <line x1="610" y1="340" x2="570" y2="240" stroke="#00B4D8" stroke-width="12" stroke-linecap="round" />

  <!-- Handlebar & Headlamp Cowl -->
  <path d="M 530 170 L 500 130 L 525 125 L 560 160 Z" fill="#0F172A" stroke="#00B4D8" stroke-width="2" />
  <line x1="490" y1="125" x2="535" y2="125" stroke="#CBD5E1" stroke-width="6" stroke-linecap="round" />
  
  <!-- Sleek LED Headlamp Beam -->
  <polygon points="565,190 730,160 740,240 570,225" fill="url(#neonGlow)" opacity="0.15" filter="url(#glowFilter)" />
  <polygon points="560,195 575,200 568,220 555,215" fill="#00B4D8" filter="url(#glowFilter)" />

  <!-- Aerodynamic Accent Line -->
  <path d="M 330 240 L 430 190 L 515 195" fill="none" stroke="url(#neonGlow)" stroke-width="4" stroke-linecap="round" filter="url(#glowFilter)" />

  <!-- Badging & Model Name -->
  <text x="435" y="225" fill="#FFFFFF" font-size="16" font-weight="900" letter-spacing="3" font-family="sans-serif">THUNDER <tspan fill="#00B4D8">PRO</tspan></text>
  <text x="435" y="240" fill="#94A3B8" font-size="9" font-weight="700" letter-spacing="1.5" font-family="sans-serif">ASKR EV PERFORMANCE</text>

  <!-- Speed & Range HUD Overlay Badges -->
  <g transform="translate(60, 40)">
    <rect width="130" height="42" rx="8" fill="#1C2541" stroke="#3A506B" opacity="0.9" />
    <text x="14" y="20" fill="#94A3B8" font-size="9" font-weight="700" font-family="sans-serif">MAX RANGE</text>
    <text x="14" y="36" fill="#10B981" font-size="16" font-weight="900" font-family="sans-serif">135 <tspan font-size="10" font-weight="600" fill="#94A3B8">KM</tspan></text>
  </g>
  <g transform="translate(205, 40)">
    <rect width="130" height="42" rx="8" fill="#1C2541" stroke="#3A506B" opacity="0.9" />
    <text x="14" y="20" fill="#94A3B8" font-size="9" font-weight="700" font-family="sans-serif">TOP VELOCITY</text>
    <text x="14" y="36" fill="#00B4D8" font-size="16" font-weight="900" font-family="sans-serif">95 <tspan font-size="10" font-weight="600" fill="#94A3B8">KM/H</tspan></text>
  </g>
</svg>
