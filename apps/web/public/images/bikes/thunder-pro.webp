<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" width="100%" height="100%">
  <defs>
    <linearGradient id="studioBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F1F5F9" />
    </linearGradient>
    <linearGradient id="bodyBlue" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#1E40AF" />
      <stop offset="50%" stop-color="#165DAD" />
      <stop offset="100%" stop-color="#0E3A6D" />
    </linearGradient>
    <filter id="softShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0F172A" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Clean Studio Background -->
  <rect width="800" height="480" fill="url(#studioBg)" rx="12" />

  <!-- Ground Soft Shadow -->
  <ellipse cx="400" cy="395" rx="310" ry="18" fill="#64748B" opacity="0.18" />

  <!-- Rear Wheel -->
  <g id="rearWheel">
    <circle cx="210" cy="335" r="74" fill="#1E293B" stroke="#0F172A" stroke-width="12" />
    <circle cx="210" cy="335" r="60" fill="#334155" stroke="#94A3B8" stroke-width="2" />
    <circle cx="210" cy="335" r="30" fill="#E2E8F0" stroke="#64748B" stroke-width="2" />
    <circle cx="210" cy="335" r="12" fill="#165DAD" />
    <line x1="210" y1="275" x2="210" y2="395" stroke="#94A3B8" stroke-width="2" />
    <line x1="150" y1="335" x2="270" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="210" cy="335" r="42" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="4,4" />
    <rect x="182" y="322" width="16" height="26" rx="3" fill="#DC2626" />
  </g>

  <!-- Front Wheel -->
  <g id="frontWheel">
    <circle cx="610" cy="335" r="74" fill="#1E293B" stroke="#0F172A" stroke-width="12" />
    <circle cx="610" cy="335" r="60" fill="#334155" stroke="#94A3B8" stroke-width="2" />
    <circle cx="610" cy="335" r="30" fill="#E2E8F0" stroke="#64748B" stroke-width="2" />
    <circle cx="610" cy="335" r="12" fill="#165DAD" />
    <line x1="610" y1="275" x2="610" y2="395" stroke="#94A3B8" stroke-width="2" />
    <line x1="550" y1="335" x2="670" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="610" cy="335" r="42" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="4,4" />
    <rect x="618" y="322" width="16" height="26" rx="3" fill="#DC2626" />
  </g>

  <!-- Swingarm -->
  <path d="M 210 335 L 380 315 L 370 340 Z" fill="#334155" />

  <!-- Battery Pack Enclosure -->
  <polygon points="290,335 480,335 495,255 315,255" fill="#1E293B" stroke="#334155" stroke-width="2" />
  <rect x="330" y="270" width="130" height="45" rx="6" fill="#0F172A" />
  <text x="395" y="297" fill="#94A3B8" font-size="11" font-weight="700" text-anchor="middle" font-family="Inter, sans-serif">3.8 kWh PMSM</text>

  <!-- Main Chassis Body in Sapphire Corporate Blue -->
  <path d="M 240 245 L 360 245 L 460 165 L 530 175 L 570 225 L 485 305 L 330 305 Z" fill="url(#bodyBlue)" filter="url(#softShadow)" />

  <!-- Ergonomic Saddle / Seat in Charcoal Leather -->
  <path d="M 230 235 Q 300 230 370 242 L 380 225 Q 300 210 240 220 Z" fill="#1E293B" />

  <!-- Front Telescopic Suspension -->
  <line x1="610" y1="335" x2="540" y2="155" stroke="#64748B" stroke-width="10" stroke-linecap="round" />
  <line x1="610" y1="335" x2="575" y2="240" stroke="#CBD5E1" stroke-width="12" stroke-linecap="round" />

  <!-- Handlebar & Cowl -->
  <path d="M 530 165 L 500 125 L 525 120 L 560 155 Z" fill="#1E293B" />
  <line x1="490" y1="120" x2="535" y2="120" stroke="#475569" stroke-width="6" stroke-linecap="round" />

  <!-- LED Projector Headlamp -->
  <polygon points="560,190 575,195 568,215 555,210" fill="#E2E8F0" />
  <circle cx="566" cy="202" r="6" fill="#165DAD" />

  <!-- Model Branding -->
  <text x="430" y="220" fill="#FFFFFF" font-size="18" font-weight="800" font-family="Inter, sans-serif">THUNDER <tspan fill="#93C5FD">PRO</tspan></text>
  <text x="430" y="235" fill="#E2E8F0" font-size="10" font-weight="500" font-family="Inter, sans-serif">ASKR EV URBAN COMMUTER</text>

  <!-- Clean Specs Pills in White Corporate Style -->
  <g transform="translate(60, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">RANGE</text>
    <text x="12" y="29" fill="#15803D" font-size="13" font-weight="800" font-family="Inter, sans-serif">135 km</text>
  </g>
  <g transform="translate(195, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">TOP SPEED</text>
    <text x="12" y="29" fill="#165DAD" font-size="13" font-weight="800" font-family="Inter, sans-serif">95 km/h</text>
  </g>
</svg>
