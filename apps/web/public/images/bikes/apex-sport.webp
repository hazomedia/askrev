<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" width="100%" height="100%">
  <defs>
    <linearGradient id="studioBg3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#F1F5F9" />
    </linearGradient>
    <linearGradient id="bodySlate" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#0F172A" />
      <stop offset="50%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>
    <filter id="softShadow3" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#0F172A" flood-opacity="0.12" />
    </filter>
  </defs>

  <!-- Clean Studio Background -->
  <rect width="800" height="480" fill="url(#studioBg3)" rx="12" />

  <!-- Ground Soft Shadow -->
  <ellipse cx="400" cy="395" rx="320" ry="18" fill="#64748B" opacity="0.18" />

  <!-- Rear Wheel -->
  <g id="rearWheel">
    <circle cx="200" cy="335" r="76" fill="#0F172A" stroke="#020617" stroke-width="14" />
    <circle cx="200" cy="335" r="62" fill="#1E293B" stroke="#64748B" stroke-width="2.5" />
    <circle cx="200" cy="335" r="32" fill="#E2E8F0" stroke="#475569" stroke-width="2" />
    <circle cx="200" cy="335" r="14" fill="#165DAD" />
    <line x1="200" y1="273" x2="200" y2="397" stroke="#94A3B8" stroke-width="2" />
    <line x1="138" y1="335" x2="262" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="200" cy="335" r="44" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="4,4" />
    <rect x="170" y="320" width="18" height="28" rx="3" fill="#DC2626" />
  </g>

  <!-- Front Wheel -->
  <g id="frontWheel">
    <circle cx="620" cy="335" r="76" fill="#0F172A" stroke="#020617" stroke-width="14" />
    <circle cx="620" cy="335" r="62" fill="#1E293B" stroke="#64748B" stroke-width="2.5" />
    <circle cx="620" cy="335" r="32" fill="#E2E8F0" stroke="#475569" stroke-width="2" />
    <circle cx="620" cy="335" r="14" fill="#165DAD" />
    <line x1="620" y1="273" x2="620" y2="397" stroke="#94A3B8" stroke-width="2" />
    <line x1="558" y1="335" x2="682" y2="335" stroke="#94A3B8" stroke-width="2" />
    <circle cx="620" cy="335" r="44" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="4,4" />
    <rect x="628" y="320" width="18" height="28" rx="3" fill="#DC2626" />
  </g>

  <!-- Aerodynamic Racing Fairings in Charcoal and Deep Blue -->
  <path d="M 220 225 L 350 235 L 460 155 L 550 165 L 610 215 L 560 325 L 420 335 L 320 335 L 290 275 Z" fill="url(#bodySlate)" filter="url(#softShadow3)" />
  
  <!-- High Capacity Battery Pack -->
  <polygon points="310,335 550,335 570,265 330,265" fill="#020617" />
  <text x="440" y="310" fill="#94A3B8" font-size="11" font-weight="700" text-anchor="middle" font-family="Inter, sans-serif">5.2 kWh HIGH-DENSITY NMC</text>

  <!-- Racing Seat -->
  <path d="M 210 215 L 310 225 L 360 230 L 360 210 L 290 200 L 210 205 Z" fill="#020617" />

  <!-- Clip-On Handlebars -->
  <line x1="620" y1="335" x2="540" y2="145" stroke="#64748B" stroke-width="10" stroke-linecap="round" />
  <line x1="540" y1="145" x2="510" y2="135" stroke="#165DAD" stroke-width="6" stroke-linecap="round" />

  <!-- Twin LED Headlamps -->
  <polygon points="575,185 600,190 590,210 570,205" fill="#E2E8F0" />
  <circle cx="585" cy="198" r="4" fill="#165DAD" />

  <!-- Model Branding -->
  <text x="430" y="215" fill="#FFFFFF" font-size="18" font-weight="800" font-family="Inter, sans-serif">APEX <tspan fill="#60A5FA">SPORT</tspan></text>
  <text x="430" y="230" fill="#CBD5E1" font-size="10" font-weight="500" font-family="Inter, sans-serif">HIGH-TORQUE PERFORMANCE</text>

  <!-- Clean Specs Pills in White Corporate Style -->
  <g transform="translate(60, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">RANGE</text>
    <text x="12" y="29" fill="#15803D" font-size="13" font-weight="800" font-family="Inter, sans-serif">175 km</text>
  </g>
  <g transform="translate(195, 40)">
    <rect width="120" height="36" rx="8" fill="#FFFFFF" stroke="#E2E8F0" />
    <text x="12" y="16" fill="#64748B" font-size="9" font-weight="600" font-family="Inter, sans-serif">TOP SPEED</text>
    <text x="12" y="29" fill="#165DAD" font-size="13" font-weight="800" font-family="Inter, sans-serif">120 km/h</text>
  </g>
</svg>
