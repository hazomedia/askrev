generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_OPERATIONS
  FINANCE_MANAGER
  MEMBER
  FREE_USER
}

enum MembershipPackage {
  FREE
  BASIC
  FULL
}

enum QualificationMethod {
  DIRECT_FULL
  UPGRADE_PAYMENT
  UPGRADE_SHOPPING
}

enum BinaryLeg {
  LEFT
  RIGHT
}

enum MembershipRequestType {
  BASIC_ACTIVATION
  FULL_ACTIVATION
  BASIC_TO_FULL_UPGRADE
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                  String             @id @default(uuid())
  memberId            String             @unique
  email               String             @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                UserRole           @default(FREE_USER)
  currentPackage      MembershipPackage  @default(FREE)
  isFullQualified     Boolean            @default(false)
  qualificationMethod QualificationMethod?
  qualificationDate   DateTime?

  sponsorId           String?
  sponsor             User?              @relation("SponsorReferrals", fields: [sponsorId], references: [id])
  directReferrals     User[]             @relation("SponsorReferrals")

  refreshTokenHash    String?

  wallet              WalletAccount?
  binaryPlacement     BinaryPlacement?
  vouchers            ShoppingVoucher[]
  bookings            EvBooking[]
  withdrawals         WithdrawalRequest[]
  membershipRequests  MembershipRequest[]
  binaryMatches       BinaryMatchEvent[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([memberId])
  @@index([sponsorId])
  @@index([role])
}

model BinaryPlacement {
  id                     String     @id @default(uuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId               String?
  leg                    BinaryLeg?
  leftCount              Int        @default(0)
  rightCount             Int        @default(0)
  leftVolumePaise        BigInt     @default(0)
  rightVolumePaise       BigInt     @default(0)
  carryLeftPaise         BigInt     @default(0)
  carryRightPaise        BigInt     @default(0)
  matchedVolumeLeftPaise BigInt     @default(0)
  matchedVolumeRightPaise BigInt    @default(0)
  totalMatchesConsumed   Int        @default(0)
  totalRewardEarnedPaise BigInt     @default(0)
  lastMatchDate          String?
  dailyMatchesCount      Int        @default(0)

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([parentId])
  @@index([leg])
}

model WalletAccount {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableEarningsPaise     BigInt   @default(0)
  heldCommissionsPaise       BigInt   @default(0)
  pendingRecoveryPaise       BigInt   @default(0)
  shoppingVoucherBalancePaise BigInt  @default(0)
  totalEarnedPaise           BigInt   @default(0)
  totalWithdrawnPaise        BigInt   @default(0)

  updatedAt                  DateTime @updatedAt
}

model JournalEntry {
  id          String        @id @default(uuid())
  referenceId String        @unique
  eventType   String
  narration   String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@index([referenceId])
  @@index([eventType])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        String
  userId         String?
  debitPaise     BigInt       @default(0)
  creditPaise    BigInt       @default(0)
  description    String

  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([account])
  @@index([userId])
}

model CommissionHold {
  id                   String    @id @default(uuid())
  sponsorId            String
  referredMemberId     String
  heldAmountPaise      BigInt
  status               String    @default("HELD") // HELD, RELEASED, FORFEITED
  releasedAt           DateTime?
  releaseTransactionId String?
  createdAt            DateTime  @default(now())

  @@index([sponsorId])
  @@index([referredMemberId])
}

model PendingRecovery {
  id                  String   @id @default(uuid())
  sponsorId           String
  referredMemberId    String
  recoveryAmountPaise BigInt
  recoveredPaise      BigInt   @default(0)
  status              String   @default("PENDING") // PENDING, PARTIALLY_RECOVERED, FULLY_RECOVERED
  createdAt           DateTime @default(now())

  @@index([sponsorId])
  @@index([referredMemberId])
}

model ShoppingVoucher {
  id                    String               @id @default(uuid())
  voucherCode           String               @unique
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialValuePaise     BigInt
  remainingBalancePaise BigInt
  issuedReason          String
  status                String               @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, FULLY_REDEEMED, PARTIALLY_REDEEMED
  expiresAt             DateTime
  transactions          VoucherTransaction[]
  bookings              EvBooking[]
  createdAt             DateTime             @default(now())

  @@index([voucherCode])
  @@index([userId])
}

model VoucherTransaction {
  id                String          @id @default(uuid())
  voucherId         String
  voucher           ShoppingVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amountPaise       BigInt
  transactionType   String          // ISSUANCE, REDEMPTION, REVERSAL, EXPIRY
  referenceId       String?
  balanceAfterPaise BigInt
  narration         String
  journalEntryId    String?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  @@index([voucherId])
  @@index([transactionType])
  @@index([referenceId])
}

model QualificationEvent {
  id                          String              @id @default(uuid())
  memberId                    String
  sponsorId                   String?
  qualificationMethod         QualificationMethod
  qualificationOrderForSponsor Int?
  feePaidPaise                BigInt              @default(0)
  voucherIssuedPaise          BigInt              @default(0)
  walletCreditedPaise         BigInt              @default(0)
  holdReleasedPaise           BigInt              @default(0)
  commissionRecoveredPaise    BigInt              @default(0)
  unfundedRecoveryPaise       BigInt              @default(0)
  journalEntryId              String?
  createdAt                   DateTime            @default(now())

  @@index([memberId])
  @@index([sponsorId])
}

model EvBike {
  id                     String      @id @default(uuid())
  modelCode              String      @unique
  name                   String
  tagline                String
  batteryCapacityKwh     Float
  rangeKm                Int
  topSpeedKmh            Int
  chargingTimeHours      Float
  exShowroomPricePaise   BigInt
  bookingAmountPaise     BigInt
  voucherRedeemLimitPaise BigInt
  imageUrl               String
  isAvailable            Boolean     @default(true)
  bookings               EvBooking[]

  createdAt              DateTime    @default(now())
}

model EvBooking {
  id                  String           @id @default(uuid())
  bookingNumber       String           @unique
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeId              String
  bike                EvBike           @relation(fields: [bikeId], references: [id])
  voucherId           String?
  voucher             ShoppingVoucher? @relation(fields: [voucherId], references: [id])
  bookingAmountPaise  BigInt
  voucherAppliedPaise BigInt           @default(0)
  netCashPaidPaise    BigInt
  bookingStatus       String           @default("SUBMITTED") // SUBMITTED, PAYMENT_VERIFIED, CONFIRMED, DELIVERED, CANCELLED
  paymentReference    String?
  cancellationReason  String?
  cancelledAt         DateTime?
  journalEntryId      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([bookingNumber])
  @@index([voucherId])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPaise BigInt
  bankDetails Json
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  adminNotes  String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
}

model MembershipRequest {
  id               String                  @id @default(uuid())
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType      MembershipRequestType
  feePaise         BigInt
  paymentMode      String                  @default("SIMULATED_TEST")
  paymentReference String?
  status           MembershipRequestStatus @default(PENDING)
  adminNotes       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  idempotencyKey   String?                 @unique
  isSimulated      Boolean                 @default(true)
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestType])
}

model BinaryMatchEvent {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchDate             String   // YYYY-MM-DD
  matchesEvaluated      Int
  matchesSettled        Int
  cappedOutMatches      Int
  leftUnitsUsed         Int
  rightUnitsUsed        Int
  previousCarryLeft     Int
  previousCarryRight    Int
  newCarryLeft          Int
  newCarryRight         Int
  rewardPaise           BigInt
  isSimulated           Boolean  @default(true)
  journalEntryId        String?
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([matchDate])
}
