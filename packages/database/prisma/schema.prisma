generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_OPERATIONS
  FINANCE_MANAGER
  MEMBER
  FREE_USER
}

enum MembershipPackage {
  FREE
  BASIC
  FULL
}

enum QualificationMethod {
  DIRECT_FULL
  UPGRADE_PAYMENT
  UPGRADE_SHOPPING
}

enum BinaryLeg {
  LEFT
  RIGHT
}

enum MembershipRequestType {
  BASIC_ACTIVATION
  FULL_ACTIVATION
  BASIC_TO_FULL_UPGRADE
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id                  String             @id @default(uuid())
  memberId            String             @unique
  email               String             @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                UserRole           @default(FREE_USER)
  currentPackage      MembershipPackage  @default(FREE)
  isFullQualified     Boolean            @default(false)
  qualificationMethod QualificationMethod?
  qualificationDate   DateTime?

  sponsorId           String?
  sponsor             User?              @relation("SponsorReferrals", fields: [sponsorId], references: [id])
  directReferrals     User[]             @relation("SponsorReferrals")

  refreshTokenHash    String?
  sessionVersion      Int                @default(1)

  // Two-Factor Authentication (TOTP RFC 6238)
  twoFactorSecret           String?
  twoFactorEnabled          Boolean            @default(false)
  twoFactorRecoveryCodes    String[]           @default([])
  pendingTwoFactorSecret    String?
  pendingTwoFactorCreatedAt DateTime?

  // Email Verification
  isEmailVerified        Boolean            @default(false)
  emailVerifiedAt        DateTime?

  // Intended Binary Placement Side (LEFT or RIGHT)
  intendedBinarySide     BinaryLeg?         @default(LEFT)

  wallet                  WalletAccount?
  binaryPlacement         BinaryPlacement?
  vouchers                ShoppingVoucher[]
  bookings                EvBooking[]
  withdrawals             WithdrawalRequest[]
  membershipRequests      MembershipRequest[]
  binaryMatches           BinaryMatchEvent[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  taxSimulationRecords    TaxSimulationRecord[]
  retailOrders            RetailOrderRecord[]
  retailQualifications    RetailQualificationEvent[]
  binaryMatchingOutbox    BinaryMatchingOutbox[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([memberId])
  @@index([sponsorId])
  @@index([role])
}

model BinaryPlacement {
  id                     String     @id @default(uuid())
  userId                 String     @unique
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId               String?
  leg                    BinaryLeg?
  leftCount              Int        @default(0)
  rightCount             Int        @default(0)
  leftVolumePaise        BigInt     @default(0)
  rightVolumePaise       BigInt     @default(0)
  carryLeftPaise         BigInt     @default(0)
  carryRightPaise        BigInt     @default(0)
  matchedVolumeLeftPaise BigInt     @default(0)
  matchedVolumeRightPaise BigInt    @default(0)
  totalMatchesConsumed   Int        @default(0)
  totalRewardEarnedPaise BigInt     @default(0)
  lastMatchDate          String?
  dailyMatchesCount      Int        @default(0)

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([parentId, leg])
  @@index([parentId])
  @@index([leg])
}

model WalletAccount {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableEarningsPaise     BigInt   @default(0)
  heldCommissionsPaise       BigInt   @default(0)
  pendingRecoveryPaise       BigInt   @default(0)
  shoppingVoucherBalancePaise BigInt  @default(0)
  totalEarnedPaise           BigInt   @default(0)
  totalWithdrawnPaise        BigInt   @default(0)

  updatedAt                  DateTime @updatedAt
}

model JournalEntry {
  id          String        @id @default(uuid())
  referenceId String        @unique
  eventType   String
  narration   String
  createdAt   DateTime      @default(now())
  lines       JournalLine[]

  @@index([referenceId])
  @@index([eventType])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        String
  userId         String?
  debitPaise     BigInt       @default(0)
  creditPaise    BigInt       @default(0)
  description    String

  createdAt      DateTime     @default(now())

  @@index([journalEntryId])
  @@index([account])
  @@index([userId])
}

model CommissionHold {
  id                   String    @id @default(uuid())
  sponsorId            String
  referredMemberId     String
  heldAmountPaise      BigInt
  status               String    @default("HELD") // HELD, RELEASED, FORFEITED
  releasedAt           DateTime?
  releaseTransactionId String?
  createdAt            DateTime  @default(now())

  @@index([sponsorId])
  @@index([referredMemberId])
}

model PendingRecovery {
  id                  String   @id @default(uuid())
  sponsorId           String
  referredMemberId    String
  recoveryAmountPaise BigInt
  recoveredPaise      BigInt   @default(0)
  status              String   @default("PENDING") // PENDING, PARTIALLY_RECOVERED, FULLY_RECOVERED
  createdAt           DateTime @default(now())

  @@index([sponsorId])
  @@index([referredMemberId])
}

model ShoppingVoucher {
  id                    String               @id @default(uuid())
  voucherCode           String               @unique
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialValuePaise     BigInt
  remainingBalancePaise BigInt
  issuedReason          String
  status                String               @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, FULLY_REDEEMED, PARTIALLY_REDEEMED
  expiresAt             DateTime
  transactions          VoucherTransaction[]
  bookings              EvBooking[]
  createdAt             DateTime             @default(now())

  @@index([voucherCode])
  @@index([userId])
}

model VoucherTransaction {
  id                String          @id @default(uuid())
  voucherId         String
  voucher           ShoppingVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  amountPaise       BigInt
  transactionType   String          // ISSUANCE, REDEMPTION, REVERSAL, EXPIRY
  referenceId       String?
  balanceAfterPaise BigInt
  narration         String
  journalEntryId    String?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  @@index([voucherId])
  @@index([transactionType])
  @@index([referenceId])
}

model QualificationEvent {
  id                          String              @id @default(uuid())
  memberId                    String
  sponsorId                   String?
  qualificationMethod         QualificationMethod
  qualificationOrderForSponsor Int?
  feePaidPaise                BigInt              @default(0)
  voucherIssuedPaise          BigInt              @default(0)
  walletCreditedPaise         BigInt              @default(0)
  holdReleasedPaise           BigInt              @default(0)
  commissionRecoveredPaise    BigInt              @default(0)
  unfundedRecoveryPaise       BigInt              @default(0)
  journalEntryId              String?
  createdAt                   DateTime            @default(now())

  @@index([memberId])
  @@index([sponsorId])
}

model EvBike {
  id                     String      @id @default(uuid())
  modelCode              String      @unique
  name                   String
  tagline                String
  batteryCapacityKwh     Float
  rangeKm                Int
  topSpeedKmh            Int
  chargingTimeHours      Float
  exShowroomPricePaise   BigInt
  bookingAmountPaise     BigInt
  voucherRedeemLimitPaise BigInt
  imageUrl               String
  isAvailable            Boolean     @default(true)
  bookings               EvBooking[]
  products               Product[]

  createdAt              DateTime    @default(now())
}

model EvBooking {
  id                  String           @id @default(uuid())
  bookingNumber       String           @unique
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bikeId              String
  bike                EvBike           @relation(fields: [bikeId], references: [id])
  voucherId           String?
  voucher             ShoppingVoucher? @relation(fields: [voucherId], references: [id])
  bookingAmountPaise  BigInt
  voucherAppliedPaise BigInt           @default(0)
  netCashPaidPaise    BigInt
  bookingStatus       String           @default("SUBMITTED") // SUBMITTED, PAYMENT_VERIFIED, CONFIRMED, DELIVERED, CANCELLED
  paymentReference    String?
  cancellationReason  String?
  cancelledAt         DateTime?
  journalEntryId      String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([userId])
  @@index([bookingNumber])
  @@index([voucherId])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPaise BigInt
  bankDetails Json
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  adminNotes  String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
}

model MembershipRequest {
  id               String                  @id @default(uuid())
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType      MembershipRequestType
  feePaise         BigInt
  paymentMode      String                  @default("SIMULATED_TEST")
  paymentReference String?
  status           MembershipRequestStatus @default(PENDING)
  adminNotes       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  idempotencyKey   String?                 @unique
  isSimulated      Boolean                 @default(true)
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([requestType])
}

model BinaryMatchEvent {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchDate             String   // YYYY-MM-DD
  matchesEvaluated      Int
  matchesSettled        Int
  cappedOutMatches      Int
  leftUnitsUsed         Int
  rightUnitsUsed        Int
  previousCarryLeft     Int
  previousCarryRight    Int
  newCarryLeft          Int
  newCarryRight         Int
  rewardPaise           BigInt
  isSimulated           Boolean  @default(true)
  journalEntryId        String?
  idempotencyKey        String?  @unique
  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([matchDate])
}

model BinaryMatchingOutbox {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerReason  String    // FULL_ACTIVATION, UPGRADE, PLACEMENT, SCHEDULER_RECOVERY, MANUAL_TRIGGER
  triggerUserId  String?
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts       Int       @default(0)
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

enum ProductCategory {
  SCOOTER
  BIKE
  CYCLE
  JEEP
  UTILITY
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                      String          @id @default(uuid())
  name                    String
  slug                    String          @unique
  category                ProductCategory
  brand                   String          @default("ASKR EV")
  tagline                 String?
  shortDescription        String?
  fullDescription         String?         @db.Text

  // Monetary values strictly in integer paise (BigInt)
  regularPricePaise       BigInt?
  sellingPricePaise       BigInt?
  bookingAmountPaise      BigInt?
  voucherRedeemLimitPaise BigInt?

  // Performance specifications (nullable where not applicable across categories)
  rangeKm                 Int?
  topSpeedKmh             Int?
  batteryCapacityKwh      Float?
  chargingTimeHours       Float?
  motorPower              String?
  acceleration            String?
  warranty                String?
  powertrain              String?

  // Structured specifications and custom styling (JSON arrays)
  colors                  Json?           // Array of { name, hex, accentHex?, description, images?, primaryImage?, sku?, isAvailable? }
  specifications          Json?           // Array of { label, value, sub? }
  highlights              Json?           // Array of string highlights

  // Media & Photo gallery management
  images                  Json?           // Array of { url, publicId?, isPrimary, order, caption? }
  heroImage               String?
  thumbnailImage          String?

  // Homepage Hero Placement
  isHero                  Boolean         @default(false)
  heroMobileImage         String?
  heroHeading             String?
  heroDescription         String?
  heroCtaText             String?
  heroCtaLink             String?
  heroSlideOrder          Int?

  // Internal OEM & Supplier Traceability (strictly internal for warranty, service, and compliance)
  oemManufacturer         String?         // e.g. "Harsil", "Eko Tejas", "Rilox"
  oemModelName            String?         // e.g. "Leo", "Sport", "Jatayu", "Retro Classic", "Tri-Star", "3W Loader"
  oemReference            String?         // e.g. "PriceSheet-60V-2026", "FactorySpec-Batch1"
  internalNotes           String?         @db.Text
  slugAliases             String[]        @default([]) // Safe redirects from legacy slugs (e.g. "harsil-leo")
  isRebranded             Boolean         @default(true)

  // Catalog status & ordering
  isFeatured              Boolean         @default(false)
  status                  ProductStatus   @default(DRAFT)
  availability            String?         @default("BOOKING_AVAILABLE")
  displayOrder            Int             @default(0)

  // Optional connection to legacy EvBike for booking integration
  evBikeId                String?
  evBike                  EvBike?         @relation(fields: [evBikeId], references: [id], onDelete: SetNull)

  // Independent Homepage Hero Slides linked to this vehicle
  heroSlides              HomepageHeroSlide[]

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([category])
  @@index([status])
  @@index([availability])
  @@index([isFeatured])
  @@index([isHero])
  @@index([displayOrder])
  @@index([slug])
}

enum HeroSlideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model HomepageHeroSlide {
  id                  String           @id @default(uuid())
  internalName        String
  heading             String
  subheading          String?
  description         String?          @db.Text
  eyebrowText         String?

  // Media Assets
  desktopImageUrl     String
  mobileImageUrl      String?
  desktopFocalX       Float            @default(50.0)
  desktopFocalY       Float            @default(50.0)
  mobileFocalX        Float            @default(50.0)
  mobileFocalY        Float            @default(50.0)
  desktopAltText      String?
  mobileAltText       String?

  // Primary Call-to-Action
  primaryCtaLabel     String?
  primaryCtaUrl       String?
  primaryCtaStyle     String           @default("PRIMARY") // PRIMARY, SECONDARY, OUTLINE
  primaryCtaEnabled   Boolean          @default(true)

  // Secondary Call-to-Action
  secondaryCtaLabel   String?
  secondaryCtaUrl     String?
  secondaryCtaStyle   String           @default("SECONDARY") // PRIMARY, SECONDARY, OUTLINE
  secondaryCtaEnabled Boolean          @default(false)

  // Optional Product Linking
  linkedProductId     String?
  linkedProduct       Product?         @relation(fields: [linkedProductId], references: [id], onDelete: SetNull)

  // Pricing & Spec overlay display settings
  showPrice           Boolean          @default(false)
  showRange           Boolean          @default(false)
  showTopSpeed        Boolean          @default(false)
  showBattery         Boolean          @default(false)
  showSpecifications  Boolean          @default(false)

  // Ordering & Lifecycle
  sortOrder           Int              @default(0)
  status              HeroSlideStatus  @default(DRAFT)
  publishStartAt      DateTime?
  publishEndAt        DateTime?

  // Audit info
  createdBy           String?
  updatedBy           String?
  version             Int              @default(1)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([sortOrder])
  @@index([linkedProductId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model BinarySimulationRun {
  id             String    @id @default(uuid())
  runDate        String    // YYYY-MM-DD in Asia/Kolkata
  status         String    // PENDING, RUNNING, COMPLETED, FAILED
  nodesEvaluated Int       @default(0)
  nodesSettled   Int       @default(0)
  pairsSettled   Int       @default(0)
  totalRewardPaise BigInt  @default(0)
  executionMode  String    @default("SIMULATION_ONLY")
  isDryRun       Boolean   @default(false)
  metadata       Json?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?
  triggeredBy    String    @default("CRON_AUTOMATED") // CRON_AUTOMATED, ADMIN_MANUAL
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([runDate, isDryRun])
  @@index([runDate])
  @@index([status])
}

model TaxSimulationRule {
  id              String                @id @default(uuid())
  ruleIdentifier  String                @unique // e.g. "TDS_194H_SIMULATED_2026"
  ruleName        String                // e.g. "Simulated Brokerage/Commission TDS"
  incomeCategory  String                // "DIRECT_SPONSOR_COMMISSION", "BINARY_MATCHING_REWARD", "ALL"
  taxRatePercent  Float                 // e.g. 5.0 (configurable)
  thresholdPaise  BigInt                @default(0) // e.g. 1500000 (₹15,000 threshold under Section 194H)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  deductionEvent  String                @default("ON_WALLET_CREDIT") // ON_WALLET_CREDIT, ON_WITHDRAWAL_REQUEST
  version         Int                   @default(1)
  isActive        Boolean               @default(true)
  disclaimer      String                @default("SIMULATED ESTIMATE ONLY: Not actual tax withheld or legal tax remittance.")
  records         TaxSimulationRecord[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([ruleIdentifier])
  @@index([isActive])
}

model TaxSimulationRecord {
  id                      String            @id @default(uuid())
  userId                  String
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId                  String
  rule                    TaxSimulationRule @relation(fields: [ruleId], references: [id])
  referenceEventType      String            // e.g. "BINARY_MATCHING_REWARD", "QUALIFIED_DIRECT_COMMISSION"
  referenceEntityId       String?           // e.g. journalEntryId or binaryMatchEventId
  taxableGrossPaise       BigInt
  simulatedDeductionPaise BigInt
  simulatedNetPaise       BigInt
  appliedRatePercent      Float
  isSimulated             Boolean           @default(true)
  idempotencyKey          String?           @unique
  createdAt               DateTime          @default(now())

  @@index([userId])
  @@index([ruleId])
  @@index([referenceEntityId])
}

model RetailQualificationConfig {
  id                          String   @id @default(uuid())
  configKey                   String   @unique @default("DEFAULT_RETAIL_QUALIFICATION")
  qualificationThresholdPaise BigInt   @default(6000000) // ₹60,000
  eligibleCategories          String[] @default(["SCOOTER", "BIKE", "CYCLE", "JEEP", "UTILITY"])
  includeVoucherRedemptions   Boolean  @default(false)
  evaluationPeriodDays        Int?     // null = all-time / one-time, or e.g. 365
  allowRefundDeductions       Boolean  @default(true)
  status                      String   @default("PENDING_BUSINESS_APPROVAL") // PENDING_BUSINESS_APPROVAL, ACTIVE_SIMULATION
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model RetailOrderRecord {
  id                         String    @id @default(uuid())
  orderNumber                String    @unique
  userId                     String
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderStatus                String    // COMPLETED, REFUNDED, CANCELLED
  grossAmountPaise           BigInt
  netCashPaidPaise           BigInt
  voucherAppliedPaise        BigInt    @default(0)
  productCategory            String
  isEligibleForQualification Boolean   @default(true)
  completedAt                DateTime  @default(now())
  refundedAt                 DateTime?
  refundAmountPaise          BigInt    @default(0)
  createdAt                  DateTime  @default(now())

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
}

model RetailQualificationEvent {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalQualifyingSpendPaise BigInt
  thresholdAppliedPaise    BigInt
  qualifyingOrderIds       String[]
  status                   String   @default("SIMULATION_PREVIEW") // SIMULATION_PREVIEW, APPROVED
  isSimulated              Boolean  @default(true)
  notes                    String?
  createdAt                DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  reason    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}



