# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/askrev?schema=public"

# Environment
NODE_ENV="development"
TZ="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Backend API Configuration
PORT=4000
API_HOST="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_APP_NAME="ASKR EV"

# Security & JWT Tokens (Replace with high-entropy secrets in production)
JWT_ACCESS_SECRET="askrev-dev-jwt-access-secret-minimum-32-chars-long!"
JWT_REFRESH_SECRET="askrev-dev-jwt-refresh-secret-minimum-32-chars-long!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Financial Safety & Compliance Flags
# Phase 1: Real-money withdrawals, direct voucher conversions and live MLM matching settlements are strictly locked.
COMPLIANCE_MODE="SIMULATION_ONLY"
ENABLE_LIVE_PAYOUTS=false
ENABLE_LIVE_MATCHING=false
ENABLE_DIRECT_VOUCHER_CASH_CONVERSION=false
